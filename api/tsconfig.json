{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": false,
    "noEmit": true
  },
  "include": ["./**/*.ts", "../contracts/**/*.ts", "../src/**/*.ts"],
  "exclude": ["../node_modules", "../src/**/*.test.ts", "./**/*.test.ts"]
}
